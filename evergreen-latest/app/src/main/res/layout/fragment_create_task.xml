<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.CreateTaskFragment">
    <LinearLayout
        android:background="@drawable/top_rounded_corners"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:layout_height="wrap_content">
            <LinearLayout
                    android:layout_marginTop="@dimen/_2sdp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textColor="@color/gray1"
                        android:fontFamily="@font/roboto_regular"
                        android:textSize="@dimen/_16ssp"
                        android:layout_marginTop="@dimen/_20sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:text="Company Name *"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/site_name"
                        android:textColorHint="@color/gray2"
                        android:fontFamily="@font/roboto_medium"
                        android:textSize="@dimen/_14ssp"
                        android:textColor="@color/black_blue"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:hint="Select  company name"
                        android:background="@drawable/edit_text_background"
                        app:layout_constraintTop_toBottomOf="@+id/text_email"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_50sdp"
                        android:inputType="textEmailAddress"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:textColor="@color/gray1"
                        android:fontFamily="@font/roboto_regular"
                        android:textSize="@dimen/_16ssp"
                        android:layout_marginTop="@dimen/_10sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:text="Branch name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/site_branch"
                        android:textColorHint="@color/gray2"
                        android:fontFamily="@font/roboto_medium"
                        android:textSize="@dimen/_14ssp"
                        android:textColor="@color/black_blue"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:hint="Select  Branch name"
                        android:background="@drawable/edit_text_background"
                        app:layout_constraintTop_toBottomOf="@+id/text_email"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_50sdp"
                        android:inputType="textEmailAddress"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />


                    <TextView
                        android:textColor="@color/gray1"
                        android:fontFamily="@font/roboto_regular"
                        android:textSize="@dimen/_16ssp"
                        android:layout_marginTop="@dimen/_10sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:text="Location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <EditText
                        android:gravity="center_vertical"
                        android:id="@+id/site_email"
                        android:textColorHint="@color/gray2"
                        android:fontFamily="@font/roboto_medium"
                        android:textSize="@dimen/_14ssp"
                        android:textColor="@color/black_blue"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:hint="Enter Location"
                        android:background="@drawable/edit_text_background"
                        app:layout_constraintTop_toBottomOf="@+id/text_email"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_50sdp"
                        android:inputType="text"
                        android:importantForAutofill="no"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:textColor="@color/gray1"
                        android:fontFamily="@font/roboto_regular"
                        android:textSize="@dimen/_16ssp"
                        android:layout_marginTop="@dimen/_20sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:text="Equipments List *"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/eq_name"
                        android:textColorHint="@color/gray2"
                        android:fontFamily="@font/roboto_medium"
                        android:textSize="@dimen/_14ssp"
                        android:textColor="@color/black_blue"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:hint="Select  Equipment"
                        android:background="@drawable/edit_text_background"
                        app:layout_constraintTop_toBottomOf="@+id/text_email"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_50sdp"
                        android:inputType="textEmailAddress"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />


                    <RelativeLayout
                        android:visibility="gone"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_22sdp"
                        android:padding="@dimen/_10ssp"
                        android:background="@drawable/edit_text_background"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_280sdp">
                        <androidx.cardview.widget.CardView

                            app:cardCornerRadius="@dimen/_10sdp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <ImageView
                                android:scaleType="centerCrop"
                                android:id="@+id/eq_image"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"/>

                        </androidx.cardview.widget.CardView>
                    </RelativeLayout>
                <include layout="@layout/specifications1"
                    android:visibility="gone"
                    android:id="@+id/specification_layout"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                    <TextView
                        android:textColor="@color/gray1"
                        android:fontFamily="@font/roboto_regular"
                        android:textSize="@dimen/_16ssp"
                        android:layout_marginTop="@dimen/_10sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:text="Issue Type *"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/issueTye"
                        android:textColorHint="@color/gray2"
                        android:fontFamily="@font/roboto_medium"
                        android:textSize="@dimen/_14ssp"
                        android:textColor="@color/black_blue"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:hint="Select  Call Type"
                        android:background="@drawable/edit_text_background"
                        app:layout_constraintTop_toBottomOf="@+id/text_email"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_50sdp"
                        android:inputType="textEmailAddress"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:textColor="@color/gray1"
                    android:fontFamily="@font/roboto_regular"
                    android:textSize="@dimen/_16ssp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    android:text="Subject *"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/title"
                    android:textColorHint="@color/gray2"
                    android:fontFamily="@font/roboto_medium"
                    android:textSize="@dimen/_14ssp"
                    android:textColor="@color/black_blue"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:hint="Enter a Brief Description of the Issue"
                    android:background="@drawable/edit_text_background"
                    app:layout_constraintTop_toBottomOf="@+id/text_email"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    android:inputType="text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
                    <TextView
                        android:textColor="@color/gray1"
                        android:fontFamily="@font/roboto_regular"
                        android:textSize="@dimen/_16ssp"
                        android:layout_marginTop="@dimen/_10sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:text="Description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:minHeight="@dimen/_150sdp"
                        android:background="@drawable/edit_text_background"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                    <EditText
                        android:paddingVertical="@dimen/_5sdp"
                        android:gravity="top"
                        android:id="@+id/desc"
                        android:textColorHint="@color/gray2"
                        android:background="@null"
                        android:fontFamily="@font/roboto_medium"
                        android:textSize="@dimen/_14ssp"
                        android:textColor="@color/black_blue"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inputType="textMultiLine"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />




</LinearLayout>
<RelativeLayout
    android:layout_marginTop="@dimen/_10sdp"
    android:id="@+id/attachfile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
                    <TextView
                        android:layout_centerVertical="true"
                        android:id="@+id/text1"
                        android:textColor="@color/gray1"
                        android:fontFamily="@font/roboto_regular"
                        android:textSize="@dimen/_16ssp"
                        android:layout_marginTop="@dimen/_20sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:text="Add Photo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

    <ImageView
        android:layout_alignParentEnd="true"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_centerVertical="true"
        android:src="@drawable/baseline_attach_file_24"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</RelativeLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:minHeight="@dimen/_150sdp"
                        android:background="@drawable/edit_text_background"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="match_parent"
                            android:id="@+id/rv_attachments"
                            android:layout_height="wrap_content"/>

                        <RelativeLayout
                            android:visibility="gone"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/_22sdp"
                            android:padding="@dimen/_10ssp"
                            android:background="@drawable/edit_text_background"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_280sdp">

                            <LinearLayout
                                android:id="@+id/rl2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_centerInParent="true"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/eq_img"
                                    android:layout_width="@dimen/_60sdp"
                                    android:layout_height="@dimen/_60sdp"
                                    android:layout_gravity="center"
                                    android:background="@null"
                                    android:gravity="top"
                                    android:src="@drawable/photograph"
                                    android:textSize="@dimen/_16ssp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_horizontal"
                                    android:fontFamily="@font/roboto_regular"
                                    android:gravity="center_horizontal"
                                    android:text="Upload company image"
                                    android:textSize="@dimen/_14ssp" />

                            </LinearLayout>
                            <RelativeLayout
                                android:visibility="gone"
                                android:id="@+id/rl3"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:scaleType="centerCrop"
                                    android:id="@+id/selectedimage"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center"/>
                                <ImageView
                                    android:id="@+id/close"
                                    android:padding="@dimen/_10sdp"
                                    android:layout_alignParentEnd="true"
                                    android:src="@drawable/baseline_close_24"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </RelativeLayout>
                        </RelativeLayout>



                    </LinearLayout>
                   <LinearLayout
                       android:weightSum="2"
                       android:orientation="horizontal"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content">
                    <com.google.android.material.card.MaterialCardView
                        app:cardBackgroundColor="@color/btn_back"
                       android:id="@+id/creat_task"
                        app:cardCornerRadius="@dimen/_8sdp"
                         android:layout_weight="1"
                       android:layout_marginHorizontal="@dimen/_2sdp"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:textSize="@dimen/_14ssp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_50sdp">
                        <TextView
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center"
                            android:textSize="@dimen/_14ssp"
                            android:layout_gravity="center"
                            android:textColor="@color/white"
                            android:text="Create Task"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </com.google.android.material.card.MaterialCardView>
                       <com.google.android.material.card.MaterialCardView
                           app:cardBackgroundColor="@color/btn_back"
                           android:id="@+id/cancel"
                           android:layout_weight="1"
                           app:cardCornerRadius="@dimen/_8sdp"
                           android:layout_marginHorizontal="@dimen/_2sdp"
                           android:layout_marginTop="@dimen/_20sdp"
                           android:textSize="@dimen/_14ssp"
                           android:layout_width="match_parent"
                           android:layout_height="@dimen/_50sdp">
                           <TextView
                               android:fontFamily="@font/roboto_regular"
                               android:gravity="center"
                               android:textSize="@dimen/_14ssp"
                               android:layout_gravity="center"
                               android:textColor="@color/white"
                               android:text="Cancel"
                               android:layout_width="match_parent"
                               android:layout_height="wrap_content"/>
                       </com.google.android.material.card.MaterialCardView>

                   </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_15sdp"/>

                </LinearLayout>








        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>