<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_height="match_parent"
    tools:context=".fragments.UploadEqpmntExcelData">

    <TextView
        android:textColor="@color/black1"
        android:includeFontPadding="false"
        android:fontFamily="@font/roboto_medium"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/company_searc"
        android:drawableStart="@drawable/breafcase"
        android:hint="Search company"
        android:drawableEnd="@drawable/drp_down1"
        android:textSize="@dimen/_16ssp"
        android:drawablePadding="@dimen/_5sdp"
        android:paddingHorizontal="@dimen/_15sdp"
        android:elevation="@dimen/_10sdp"
        android:paddingVertical="@dimen/_14sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_30sdp"
        android:background="@drawable/rectangler_searc_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>


    <EditText
        android:editable="false"
        android:includeFontPadding="false"
        android:fontFamily="@font/roboto_medium"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/branch_searc"
        android:drawableStart="@drawable/breafcase"
        android:hint="Search branch"
        android:drawableEnd="@drawable/drp_down1"
        android:textSize="@dimen/_16ssp"
        android:drawablePadding="@dimen/_5sdp"
        android:paddingHorizontal="@dimen/_15sdp"
        android:elevation="@dimen/_10sdp"
        android:paddingVertical="@dimen/_14sdp"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_30sdp"
        android:background="@drawable/rectangler_searc_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:padding="@dimen/_6sdp"
        android:background="@drawable/rectangler_searc_back"
        android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_50sdp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
android:id="@+id/choose_file"
            android:layout_marginHorizontal="@dimen/_5sdp"
          android:paddingVertical="@dimen/_8sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:fontFamily="@font/roboto_regular"
            android:textSize="@dimen/_16ssp"
            android:backgroundTint="#D9D9D9"
            android:background="@drawable/rounded_corners"
            android:textColor="@color/black1"
            android:text="Choose file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/file_name"
            android:layout_marginHorizontal="@dimen/_2sdp"
            android:fontFamily="@font/roboto_regular"
            android:textSize="@dimen/_16ssp"
            android:textColor="@color/black_blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>


    <com.google.android.material.card.MaterialCardView
        app:cardBackgroundColor="@color/btn_back"
        android:id="@+id/uploadDocument"
android:layout_marginHorizontal="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_50sdp"
        android:textSize="@dimen/_14ssp"

        app:cardCornerRadius="@dimen/_6sdp"
        app:layout_constraintTop_toBottomOf="@+id/relative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:padding="@dimen/_14sdp"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:textSize="@dimen/_18ssp"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:text="Submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>