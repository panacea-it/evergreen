<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
app:cardBackgroundColor="@color/white"
    app:cardElevation="@dimen/_3sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="@dimen/_5sdp"
    app:cardCornerRadius="@dimen/_8sdp"
    android:layout_height="wrap_content">

    <LinearLayout

        android:paddingHorizontal="@dimen/_5sdp"
        android:paddingVertical="@dimen/_10sdp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_200sdp">
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_gravity="center"
                android:id="@+id/image"
                android:adjustViewBounds="true"
                app:shapeAppearanceOverlay="@style/RoundedImageView"
                android:scaleType="centerCrop"
                android:src="@drawable/place_holder1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:id="@+id/equipment_menu"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@drawable/bg_white_10"
                android:padding="@dimen/_7sdp"
                android:contentDescription="Equipment actions"
                android:src="@drawable/ic_more_vert"
                android:tint="@color/black_blue" />
        </RelativeLayout>
        <LinearLayout
            android:paddingVertical="@dimen/_10sdp"
           android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        <TextView
            android:id="@+id/name"
            android:fontFamily="@font/roboto_medium"
            android:textSize="@dimen/_14ssp"
            android:textColor="@color/black1"
            android:text="Leica TS13"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/make"
            android:layout_marginTop="@dimen/_5sdp"
            android:fontFamily="@font/roboto_regular"
            android:textColor="@color/black_blue1"
            android:textSize="@dimen/_14ssp"
            android:text="Make: -"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/s_number"
            android:layout_marginTop="@dimen/_5sdp"
            android:fontFamily="@font/roboto_regular"
            android:textColor="@color/black_blue1"
            android:textSize="@dimen/_14ssp"
            android:text="Serial number: 23456789"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/view_more"
                android:paddingHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:textSize="@dimen/_14ssp"
                android:background="@color/edit_text1"
                android:fontFamily="@font/roboto_regular"
                android:textColor="@color/black1"
                android:text="View more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>