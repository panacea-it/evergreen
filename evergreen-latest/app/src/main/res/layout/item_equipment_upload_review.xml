<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_10sdp"
    android:layout_marginVertical="@dimen/_5sdp"
    app:cardCornerRadius="@dimen/_8sdp"
    app:strokeColor="#D9E0EB"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_12sdp">

        <TextView
            android:id="@+id/tv_equipment_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/black_blue"
            android:textSize="@dimen/_16ssp"
            android:text="Equipment name" />

        <TextView
            android:id="@+id/tv_equipment_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:textColor="@color/gray1"
            android:textSize="@dimen/_13ssp"
            android:text="Make · Model · Location" />

        <TextView
            android:id="@+id/tv_equipment_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/gray1"
            android:textSize="@dimen/_12ssp"
            android:text="Specifications and description" />

        <TextView
            android:id="@+id/btn_edit_equipment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/_6sdp"
            android:background="@drawable/rounded_corners"
            android:backgroundTint="@color/btn_back"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingVertical="@dimen/_7sdp"
            android:text="Edit row"
            android:textColor="@color/white"
            android:textSize="@dimen/_13ssp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
