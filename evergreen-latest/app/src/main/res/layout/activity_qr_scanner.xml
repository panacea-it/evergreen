<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:fitsSystemWindows="true"
    android:background="@color/home_page_bg"
    android:layout_height="match_parent"
    tools:context=".activities.QrScanner">
<androidx.constraintlayout.widget.Guideline
    android:layout_width="match_parent"
    android:orientation="horizontal"
    android:id="@+id/guidline"
    app:layout_constraintGuide_percent="0.15"
    android:layout_height="wrap_content"/>
    <ImageView
        android:contentDescription="@string/desc"
        android:id="@+id/back"
        android:layout_margin="@dimen/_15sdp"
        android:src="@drawable/back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="@dimen/_45sdp"
        android:layout_height="@dimen/_45sdp"/>
    <TextView
        android:id="@+id/text1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textColor="@color/black1"
        android:textSize="@dimen/_16ssp"
        android:fontFamily="@font/roboto_medium"
        app:layout_constraintTop_toBottomOf="@+id/guidline"
        android:text="Scan code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/text2"
        android:alpha="0.7"
        android:layout_marginTop="@dimen/_10sdp"
        android:textAlignment="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textColor="@color/gray2"
        android:textSize="@dimen/_14ssp"
        android:fontFamily="@font/roboto_regular"
        app:layout_constraintTop_toBottomOf="@+id/text1"
        android:text="Point your camera at a QR code.\nOnce it's recognized, we'll take you to the link."
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <androidx.camera.view.PreviewView
        app:layout_constraintTop_toBottomOf="@+id/text2"
        android:id="@+id/previe_view"
        android:layout_width="@dimen/_250sdp"
        android:layout_height="@dimen/_250sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        app:layout_constraintBottom_toTopOf="@+id/text3"
        android:weightSum="3"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/previe_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_flash"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:padding="@dimen/_10sdp"
            android:background="@drawable/bg_search_field"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/black1"
            android:text="Turn on flash"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>
        <View
            android:layout_weight="0.5"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <TextView
            android:id="@+id/tv_pick_from"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:padding="@dimen/_10sdp"
            android:background="@drawable/bg_search_field"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/black1"
            android:text="Pick from photos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView
        android:id="@+id/text3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textColor="@color/black1"
        android:textSize="@dimen/_16ssp"
        android:fontFamily="@font/roboto_medium"
       app:layout_constraintBottom_toTopOf="@+id/text4"
        android:text="Having trouble scanning?"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
      app:layout_constraintBottom_toTopOf="@+id/guidline1"
        android:id="@+id/text4"
        android:alpha="0.7"
        android:textAlignment="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textColor="@color/gray2"
        android:textSize="@dimen/_12ssp"
        android:fontFamily="@font/roboto_regular"
        android:text="Make sure the QR code is well lit and in focus. It should be centered in your viewfinder."
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:id="@+id/guidline1"
        app:layout_constraintGuide_percent="0.95"
        android:layout_height="wrap_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>

