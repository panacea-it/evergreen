<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="horizontal"
    android:weightSum="4"
    android:layout_height="@dimen/_50sdp">
    <LinearLayout
        android:layout_margin="@dimen/_5sdp"
        android:gravity="center"
        android:layout_weight="1"
        android:backgroundTint="#40D02B14"
        android:background="@drawable/rounded_corners"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/open"
            android:textSize="@dimen/_14ssp"
            android:fontFamily="@font/roboto_medium"
            android:textColor="#D02B14"
            android:text="0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:lines="2"
            android:autoSizeTextType="uniform"
            android:autoSizePresetSizes="@array/autosize_text_sizes"
            android:textSize="@dimen/_12ssp"
            android:layout_gravity="center"
            android:fontFamily="@font/roboto_medium"
            android:textColor="#D02B14"
            android:text="Open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
        <LinearLayout
            android:layout_margin="@dimen/_5sdp"
            android:gravity="center"
            android:layout_weight="1"
            android:backgroundTint="#4060A9F2"
            android:background="@drawable/rounded_corners"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/totaltasks"
                android:fontFamily="@font/roboto_medium"
                android:textColor="#60A9F2"
                android:text="0"
                android:textSize="@dimen/_14ssp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
               android:lines="2"
                android:autoSizeTextType="uniform"
                android:autoSizePresetSizes="@array/autosize_text_sizes"
                android:textAlignment="center"
                android:layout_gravity="center"
                android:fontFamily="@font/roboto_medium"
                android:textColor="#60A9F2"
                android:text="Hold"
                android:textSize="@dimen/_12ssp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
     
        <LinearLayout
            android:layout_margin="@dimen/_5sdp"
            android:gravity="center"
            android:layout_weight="1"
            android:backgroundTint="#40FFA215"
            android:background="@drawable/rounded_corners"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/inprogress"
                android:textSize="@dimen/_14ssp"
                android:fontFamily="@font/roboto_medium"
                android:textColor="#FFA215"
                android:text="0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:lines="2"
                android:autoSizeTextType="uniform"
                android:autoSizePresetSizes="@array/autosize_text_sizes"
                android:textSize="@dimen/_12ssp"
                android:textAlignment="center"
                android:layout_gravity="center"
                android:fontFamily="@font/roboto_medium"
                android:textColor="#FFA215"
                android:text="In Progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:layout_margin="@dimen/_5sdp"
            android:gravity="center"
            android:layout_weight="1"
            android:backgroundTint="#4049AB1B"
            android:background="@drawable/rounded_corners"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/completed"
                android:textSize="@dimen/_14ssp"
                android:fontFamily="@font/roboto_medium"
                android:textColor="#49AB1B"
                android:text="0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:lines="2"
                android:autoSizeTextType="uniform"
                android:autoSizePresetSizes="@array/autosize_text_sizes"
                android:textSize="@dimen/_12ssp"
                android:layout_gravity="center"
                android:fontFamily="@font/roboto_medium"
                android:textColor="#49AB1B"
                android:text="Closed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>



</LinearLayout>