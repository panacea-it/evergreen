<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/black_blue"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent"
    tools:context=".activities.EquipmentsList">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        app:contentInsetStart="0dp"
        android:background="@color/black_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <ImageView
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_centerVertical="true"
            android:id="@+id/back"
            android:src="@drawable/back"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"/>
        <TextView
            android:layout_centerVertical="true"
            android:gravity="left|center"
            android:layout_marginLeft="@dimen/_50sdp"
            android:textColor="@color/white"
            android:includeFontPadding="false"
            android:textSize="@dimen/_18ssp"
            android:fontFamily="@font/roboto_medium"
            android:layout_gravity="center"
            android:text="Equipments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:id="@+id/tv_add_eq"
            android:backgroundTint="@color/black_blue"
            android:textSize="@dimen/_12ssp"
            android:fontFamily="@font/roboto_regular"
            android:textColor="@color/white"
            android:padding="@dimen/_10sdp"
            android:background="@drawable/tooltip_background"
            android:layout_marginEnd="@dimen/_15sdp"
            android:layout_gravity="end"
            android:text="+ Add equipment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:background="@color/home_page_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        android:layout_height="0dp">
        <EditText
            android:id="@+id/et_search"
            android:drawableStart="@drawable/search"
            android:hint="Search..."
            android:textSize="@dimen/_14ssp"
            android:drawablePadding="@dimen/_5sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:elevation="0dp"
            android:paddingVertical="@dimen/_14sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_16sdp"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_search_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:id="@+id/recycler_companies"
            android:layout_marginTop="@dimen/_5sdp"
            app:spanCount="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_search"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            android:orientation="vertical"
            android:layout_height="0dp"/>

        <LinearLayout
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:visibility="gone"
            android:id="@+id/no_data_layout"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.airbnb.lottie.LottieAnimationView
                android:adjustViewBounds="true"
                android:layout_width="@dimen/_150sdp"
                android:layout_height="@dimen/_150sdp"
                android:id="@+id/animation_view"
                app:lottie_rawRes="@raw/empty"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"/>
            <TextView
                android:textSize="@dimen/_14ssp"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/black_blue1"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/roboto_medium"
                android:text="No Data Found"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>