<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_page_bg"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.CreateAmcFragment">

    <LinearLayout
        android:background="@drawable/top_rounded_corners"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/_15sdp"
            android:layout_height="match_parent">

            <TextView
                android:visibility="gone"
                android:textColor="@color/black_blue"
                android:fontFamily="@font/roboto_bold"
                android:textSize="@dimen/_18ssp"
                android:id="@+id/text1"
                android:layout_marginTop="@dimen/_20sdp"
                app:layout_constraintStart_toStartOf="parent"
                android:text="@string/registration"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:visibility="gone"
                android:textSize="@dimen/_12ssp"
                android:textColor="#7A869A"
                android:fontFamily="@font/roboto_regular"
                android:id="@+id/text2"
                android:layout_marginTop="@dimen/_5sdp"
                app:layout_constraintStart_toStartOf="parent"
                android:text="@string/please_enter_the_verification_code"
                app:layout_constraintTop_toBottomOf="@+id/text1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_marginTop="@dimen/_2sdp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textColor="@color/gray1"
                        android:fontFamily="@font/roboto_regular"
                        android:textSize="@dimen/_14ssp"
                        android:layout_marginTop="@dimen/_20sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:text="Site name *"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <EditText
android:id="@+id/sitename"
                        android:fontFamily="@font/roboto_medium"
                        android:textSize="@dimen/_16ssp"
                        android:textColorHint="@color/gray2"
                        android:textColor="@color/black_blue"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:hint="Enter site name"
                        android:background="@drawable/edit_text_background"
                        app:layout_constraintTop_toBottomOf="@+id/text_email"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_50sdp"
                        android:inputType="text"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:textColor="@color/gray1"
                        android:fontFamily="@font/roboto_regular"
                        android:textSize="@dimen/_14ssp"
                        android:layout_marginTop="@dimen/_10sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:text="Branch name *"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <EditText
                        android:id="@+id/site_branch"
                        android:fontFamily="@font/roboto_medium"
                        android:textSize="@dimen/_16ssp"
                        android:textColorHint="@color/gray2"
                        android:textColor="@color/black_blue"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:hint="Please enter branch name"
                        android:background="@drawable/edit_text_background"
                        app:layout_constraintTop_toBottomOf="@+id/text_email"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_50sdp"
                        android:inputType="textEmailAddress"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />


                    <TextView
                        android:visibility="gone"
                        android:textColor="@color/gray1"
                        android:fontFamily="@font/roboto_regular"
                        android:textSize="@dimen/_14ssp"
                        android:layout_marginTop="@dimen/_10sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:text="Company Email ID"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <EditText
                        android:visibility="gone"
                        android:id="@+id/site_email"
                        android:fontFamily="@font/roboto_medium"
                        android:autofillHints="emailAddress"
                        android:textSize="@dimen/_16ssp"
                        android:textColorHint="@color/gray2"
                        android:textColor="@color/black_blue"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:hint="@string/enter_email_address"
                        android:background="@drawable/edit_text_background"
                        app:layout_constraintTop_toBottomOf="@+id/text_email"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_50sdp"
                        android:inputType="text"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />



                    <LinearLayout
                        android:layout_marginTop="@dimen/_20sdp"
                        android:weightSum="2"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_marginEnd="@dimen/_2sdp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textColor="@color/gray1"
                                android:fontFamily="@font/roboto_regular"
                                android:textSize="@dimen/_14ssp"
                                app:layout_constraintStart_toStartOf="parent"
                                android:text="Start Date *"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:id="@+id/start_date"
                                android:gravity="center"
                                android:fontFamily="@font/roboto_medium"
                                android:drawablePadding="@dimen/_5sdp"
                                android:textSize="@dimen/_16ssp"
                                android:textColorHint="@color/gray2"
                                android:textColor="@color/black_blue"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:paddingHorizontal="@dimen/_10sdp"
                                android:hint="Select Date"
                                android:background="@drawable/edit_text_background"
                                app:drawableEndCompat="@drawable/arrow_down"
                                app:layout_constraintTop_toBottomOf="@+id/text_email"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_50sdp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginStart="@dimen/_2sdp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textColor="@color/gray1"
                                android:fontFamily="@font/roboto_regular"
                                android:textSize="@dimen/_14ssp"
                                app:layout_constraintStart_toStartOf="parent"
                                android:text="End Date *"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                            <TextView
                                android:id="@+id/end_date"
                                android:gravity="center"
                                android:fontFamily="@font/roboto_medium"
                                android:drawablePadding="@dimen/_5sdp"
                                android:textSize="@dimen/_16ssp"
                                android:textColorHint="@color/gray2"
                                android:textColor="@color/black_blue"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:paddingHorizontal="@dimen/_10sdp"
                                android:hint="Select Date"
                                android:background="@drawable/edit_text_background"
                                app:drawableEndCompat="@drawable/arrow_down"
                                app:layout_constraintTop_toBottomOf="@+id/text_email"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_50sdp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:visibility="gone"
                        android:textColor="@color/gray1"
                        android:fontFamily="@font/roboto_regular"
                        android:textSize="@dimen/_14ssp"
                        android:layout_marginTop="@dimen/_10sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:text="Site Location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <EditText
                        android:visibility="gone"
                        android:id="@+id/site_location"
                        android:fontFamily="@font/roboto_medium"
                        android:textSize="@dimen/_16ssp"
                        android:textColorHint="@color/gray2"
                        android:textColor="@color/black_blue"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:hint="Please enter site location"
                        android:background="@drawable/edit_text_background"
                        app:layout_constraintTop_toBottomOf="@+id/text_email"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_50sdp"
                        android:inputType="text"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:textColor="@color/gray1"
                        android:fontFamily="@font/roboto_regular"
                        android:textSize="@dimen/_14ssp"
                        android:layout_marginTop="@dimen/_10sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:text="Add Photo *"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <RelativeLayout
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:padding="@dimen/_10ssp"
                        android:background="@drawable/edit_text_background"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_280sdp">

                        <LinearLayout
                            android:id="@+id/imageupload"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_centerInParent="true"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/site_image"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@null"
                                android:gravity="top"
                                android:src="@drawable/photograph"
                                android:textSize="@dimen/_16ssp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:fontFamily="@font/roboto_regular"
                                android:gravity="center_horizontal"
                                android:text="Upload company image"
                                android:textSize="@dimen/_14ssp" />

                        </LinearLayout>
                        <RelativeLayout
                            android:visibility="gone"
                            android:id="@+id/rl2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:scaleType="centerCrop"
                                android:src="@mipmap/ic_launcher_round"
                                android:id="@+id/selectedimage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"/>
                            <ImageView
                                android:id="@+id/close"
                                android:padding="@dimen/_10sdp"
                                android:layout_alignParentEnd="true"
                                android:src="@drawable/baseline_close_24"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </RelativeLayout>
                    </RelativeLayout>

                    <include layout="@layout/poc"
                        android:id="@+id/poc"
                        />


                    <com.google.android.material.card.MaterialCardView
                        app:cardBackgroundColor="@color/btn_back"
                        android:text="@string/sign_in"
                        android:id="@+id/create_amc"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:textSize="@dimen/_14ssp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_50sdp">
                        <TextView
                            android:fontFamily="@font/roboto_medium"
                            android:gravity="center"
                            android:textSize="@dimen/_14ssp"
                            android:layout_gravity="center"
                            android:textColor="@color/white"
                            android:text="@string/choose_amc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </com.google.android.material.card.MaterialCardView>


                    <TextView
                        android:layout_marginTop="@dimen/_20sdp"
                        android:textColor="@color/black_blue"
                        android:textSize="@dimen/_8ssp"
                        android:fontFamily="@font/roboto_regular"
                        android:textAlignment="center"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:text="@string/copyright_panaceaitservices_2023_all_rights_reserved"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_10sdp"/>

                </LinearLayout>








        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>