<!-- feedback_dialog.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:textColor="@color/black_blue1"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reason"
        android:textSize="20sp"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center" />
    <androidx.appcompat.widget.SwitchCompat
        android:text="Need Parts ?"
        android:visibility="gone"
        android:id="@+id/sw_req"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/sidestroke"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatSpinner
            android:layout_width="match_parent"
            android:id="@+id/sp_reason"
            android:paddingVertical="@dimen/_12sdp"
            android:entries="@array/type_reason"
            android:layout_height="wrap_content"/>
    </RelativeLayout>

    <EditText
        android:textSize="@dimen/_16ssp"
        android:id="@+id/spars_part_number"
        android:paddingHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:paddingVertical="@dimen/_12sdp"
        android:hint="Spare Part number"
        android:background="@drawable/sidestroke"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_gravity="center"
        android:gravity="center"
        android:background="@drawable/sidestroke"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_centerVertical="true"
            android:id="@+id/password_icon1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/baseline_image_24" />
        <TextView
            android:inputType="text"
            android:id="@+id/choose_tv"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:layout_toEndOf="@id/password_icon1"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:hint="File Name"
            android:ellipsize="end"
            android:textSize="@dimen/_12ssp"
            android:layout_toStartOf="@+id/hide_icon1"
            android:textColor="@color/black_blue"
            android:textColorHint="@color/gray2"
            android:background="@android:color/transparent" />

        <ImageView

            android:id="@+id/hide_icon1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerInParent="true"
            android:padding="@dimen/_10sdp"
            android:src="@drawable/baseline_attach_file_24" />


    </RelativeLayout>



    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:hint="Enter Reason"

        android:layout_marginTop="@dimen/_15sdp"
        android:layout_height="wrap_content">



        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/feedback_input"
            android:background="@drawable/sidestroke"
            android:layout_width="match_parent"
            android:textColor="@color/black_blue"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textSize="@dimen/_16ssp"
            android:gravity="start" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.card.MaterialCardView
        app:cardBackgroundColor="@color/btn_back"
        android:id="@+id/submit_button"
        android:layout_marginTop="@dimen/_15sdp"
        android:textSize="@dimen/_14ssp"
        app:cardCornerRadius="@dimen/_5sdp"
        app:layout_constraintTop_toBottomOf="@+id/relative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:padding="@dimen/_14sdp"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:textSize="@dimen/_18ssp"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:text="Submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        app:cardBackgroundColor="@color/gray1"
        android:id="@+id/close_button"
        android:layout_marginTop="@dimen/_15sdp"
        android:textSize="@dimen/_14ssp"
        app:cardCornerRadius="@dimen/_5sdp"
        app:layout_constraintTop_toBottomOf="@+id/relative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:padding="@dimen/_14sdp"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:textSize="@dimen/_18ssp"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:text="Close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
