<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="@dimen/_10sdp"
    android:layout_margin="@dimen/_5sdp"
    android:layout_height="wrap_content">
    <LinearLayout

        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="wrap_content">
    <LinearLayout
        android:layout_margin="@dimen/_8sdp"
        android:baselineAligned="false"
        android:weightSum="2"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_weight="1.5"
            android:layout_width="0dp"
            android:orientation="vertical"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_marginTop="@dimen/_5sdp"
                    android:weightSum="3"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="@color/gray1"
                        android:textSize="@dimen/_14ssp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/roboto_regular"
                        android:text="Issues "
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <ImageView
                        android:src="@drawable/timer"
                        android:layout_width="@dimen/_14sdp"
                        android:layout_height="@dimen/_15sdp"/>
                    <TextView
                        android:layout_marginStart="@dimen/_2sdp"
                        android:id="@+id/days"
                        android:textColor="@color/colorRed"
                        android:textSize="@dimen/_14ssp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/roboto_regular"
                        android:text="1 day left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
                <TextView
                    android:id="@+id/title"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:textSize="@dimen/_16ssp"
                    android:textColor="@color/black_blue"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/roboto_medium"
                    android:layout_weight="1"
                    android:text="Launch the summer sale campaign"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/description"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:textColor="@color/gray1"
                    android:textAlignment="textStart"
                    android:textSize="@dimen/_14ssp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/roboto_regular"
                    android:layout_weight="1"
                    android:text="Coordinate with the design and engineering teams to make sure all the assets are ready to go, and that the website is updated to reflect the discount codes and promotional offers."
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_marginTop="@dimen/_5sdp"
                    android:weightSum="2"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:id="@+id/ll_eqname"
                        android:layout_weight="1"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/black_blue"
                            android:textSize="@dimen/_14ssp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Equpment Name :"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:layout_marginStart="@dimen/_2sdp"
                            android:id="@+id/eq_name"
                            android:textColor="@color/black2"
                            android:textSize="@dimen/_14ssp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/roboto_regular"
                            android:text="-"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_serial_num"
                        android:layout_weight="1"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/black_blue"
                            android:textSize="@dimen/_14ssp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/roboto_regular"
                            android:text="S.No :"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:layout_marginStart="@dimen/_2sdp"
                            android:id="@+id/eq_sno"
                            android:textColor="@color/black2"
                            android:textSize="@dimen/_14ssp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/roboto_regular"
                            android:text="-"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_technician"
                        android:layout_weight="1"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/black_blue"
                            android:textSize="@dimen/_14ssp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Assigned Technician:"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:layout_marginStart="@dimen/_2sdp"
                            android:id="@+id/technician"
                            android:textColor="@color/black2"
                            android:textSize="@dimen/_14ssp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Kiran"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/black_blue"
                            android:textSize="@dimen/_14ssp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Company:"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:layout_marginStart="@dimen/_2sdp"
                            android:id="@+id/company"
                            android:textColor="@color/black2"
                            android:textSize="@dimen/_14ssp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/roboto_regular"
                            android:text="TCS"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/black_blue"
                            android:textSize="@dimen/_14ssp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Created at :"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:layout_marginStart="@dimen/_2sdp"
                            android:id="@+id/created_date"
                            android:textColor="@color/black2"
                            android:textSize="@dimen/_14ssp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/roboto_regular"
                            android:text="TCS"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/black_blue"
                            android:textSize="@dimen/_14ssp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Ticket No. :"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:layout_marginStart="@dimen/_2sdp"
                            android:id="@+id/ticket_no"
                            android:textColor="@color/black2"
                            android:textSize="@dimen/_14ssp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/roboto_regular"
                            android:text="TCS"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/black_blue"
                            android:textSize="@dimen/_14ssp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Status : "
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:layout_marginStart="@dimen/_2sdp"
                            android:id="@+id/status"
                            android:textColor="@color/colorRed"
                            android:textSize="@dimen/_14ssp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/roboto_regular"
                            android:text="TCS"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:visibility="gone"
                        android:id="@+id/ll_reson"
                        android:layout_weight="1"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textColor="@color/black_blue"
                            android:textSize="@dimen/_14ssp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/roboto_regular"
                            android:text="Reason : "
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:layout_marginStart="@dimen/_2sdp"
                            android:id="@+id/tv_reason"
                            android:textColor="@color/colorRed"
                            android:textSize="@dimen/_14ssp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/roboto_regular"
                            android:text="TCS"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>


                </LinearLayout>


            </LinearLayout>

        </LinearLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:layout_weight="0.5"
            android:layout_width="0dp"
            android:layout_height="match_parent">
            <ImageView
                android:visibility="gone"
                android:layout_marginEnd="@dimen/_15sdp"
                android:id="@+id/edit_reason"
                android:layout_alignParentEnd="true"
                android:src="@drawable/baseline_edit_square_24"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_centerHorizontal="true"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_45sdp"/>
            <ImageView
                android:visibility="gone"
                android:layout_marginEnd="@dimen/_15sdp"
                android:id="@+id/download"
                android:layout_alignParentEnd="true"
                android:src="@drawable/baseline_share_24"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_centerHorizontal="true"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_30sdp"/>
            <ImageView
                android:layout_centerInParent="true"
                android:layout_gravity="center_vertical"
                android:id="@+id/image"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:src="@drawable/dummy_text1"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_100sdp"/>

            <ImageView
                android:layout_below="@+id/image"
                android:id="@+id/completed"
                android:visibility="gone"
                android:src="@drawable/completed"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_centerHorizontal="true"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_30sdp"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/action_btn"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:weightSum="2"
        android:paddingVertical="@dimen/_10sdp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_marginHorizontal="@dimen/_2sdp"
            android:layout_weight="1"
            android:visibility="gone"
            android:id="@+id/tv_hold"
            android:backgroundTint="@color/edit_text1"
            android:background="@drawable/rounded_corners"
            android:paddingHorizontal="@dimen/_15sdp"
            android:paddingVertical="@dimen/_8sdp"
            android:textSize="@dimen/_14ssp"
            android:layout_gravity="center"
            android:gravity="center"
            android:fontFamily="@font/roboto_regular"
            android:textColor="@color/black1"
            android:text="Hold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_marginHorizontal="@dimen/_2sdp"
            android:layout_weight="1"
            android:visibility="gone"
            android:id="@+id/task_status_updater"
            android:backgroundTint="@color/edit_text1"
            android:background="@drawable/rounded_corners"
            android:paddingHorizontal="@dimen/_15sdp"
            android:paddingVertical="@dimen/_8sdp"
            android:textSize="@dimen/_14ssp"
            android:layout_gravity="center"
            android:gravity="center"
            android:fontFamily="@font/roboto_regular"
            android:textColor="@color/black1"
            android:text="Accept"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>


    </LinearLayout>

    <TextView
        android:visibility="gone"
        android:layout_marginTop="@dimen/_5sdp"
        android:textColor="@color/black_blue"
        android:textSize="@dimen/_14ssp"
        android:id="@+id/content"
        android:paddingVertical="@dimen/_10sdp"
        android:layout_gravity="center"
        android:gravity="center"
        android:includeFontPadding="false"
        android:fontFamily="@font/roboto_regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>