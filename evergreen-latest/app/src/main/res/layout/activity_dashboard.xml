<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@drawable/kitechn_back"
    android:layout_height="match_parent"
    tools:context=".Dashboard">
    <androidx.appcompat.widget.Toolbar
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/menu"
            android:src="@drawable/menu"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"/>
        <TextView
            android:id="@+id/title"
            android:layout_toEndOf="@+id/menu"
            android:paddingHorizontal="@dimen/_5sdp"
            android:textSize="@dimen/_14ssp"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/white"
            android:text="@string/companies_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
            <LinearLayout
               android:layout_alignParentEnd="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:src="@drawable/scanner"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"/>
                <ImageView
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:src="@drawable/notification"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"/>
                <ImageView
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:src="@drawable/menu"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"/>
            </LinearLayout>

        </RelativeLayout>

    </androidx.appcompat.widget.Toolbar>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_marginTop="@dimen/_50sdp"
        android:layout_width="match_parent"
        android:background="@color/home_page_bg"
        android:layout_height="match_parent">
        <EditText
            android:id="@+id/et_searc"
            android:drawableStart="@drawable/search"
            android:hint="Search..."
            android:textSize="@dimen/_14ssp"
            android:drawablePadding="@dimen/_5sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:elevation="0dp"
           android:paddingVertical="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_16sdp"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_search_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:id="@+id/recycler_companies"
            android:layout_marginTop="@dimen/_5sdp"
            app:spanCount="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_searc"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:orientation="vertical"
            android:layout_height="0dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>