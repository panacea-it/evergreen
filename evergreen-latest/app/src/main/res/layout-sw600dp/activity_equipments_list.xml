<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/home_page_bg"
    android:layout_height="match_parent"
    tools:context=".activities.EquipmentsList">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/back"
            android:src="@drawable/back"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"/>
        <TextView
            android:includeFontPadding="false"
            android:textSize="@dimen/_18ssp"
            android:fontFamily="@font/roboto_medium"
            android:layout_gravity="center"
            android:text="Equipments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tv_add_eq"
            android:backgroundTint="#009688"
            android:textSize="@dimen/_12ssp"
            android:fontFamily="@font/roboto_regular"
            android:textColor="@color/white"
            android:padding="@dimen/_10sdp"
            android:background="@drawable/tooltip_background"
            android:layout_marginEnd="@dimen/_15sdp"
            android:layout_gravity="end"
            android:text="+ Add equipment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </androidx.appcompat.widget.Toolbar>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        android:layout_height="0dp">
        <EditText
            android:id="@+id/et_searc"
            android:drawableStart="@drawable/search"
            android:hint="Search..."
            android:textSize="@dimen/_14ssp"
            android:drawablePadding="@dimen/_5sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:elevation="0dp"
            android:paddingVertical="@dimen/_14sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_16sdp"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_search_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:id="@+id/recycler_companies"
            android:layout_marginTop="@dimen/_5sdp"
            app:spanCount="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_searc"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            android:orientation="vertical"
            android:layout_height="0dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>